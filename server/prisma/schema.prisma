datasource db {
  provider = "sqlite"
  url      = "file:./careflow.db"
}

generator client {
  provider = "prisma-client-js"
}

// Role: "PATIENT" | "DOCTOR" | "ADMIN"
// AppointmentStatus: "SCHEDULED" | "CHECKED_IN" | "IN_CONSULTATION" | "COMPLETED" | "CANCELLED" | "NO_SHOW"
// QueueStatus: "WAITING" | "CALLED" | "IN_PROGRESS" | "FINISHED" | "SKIPPED"

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         String      @default("PATIENT") // PATIENT, DOCTOR, ADMIN
  avatarUrl    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relationships
  patientProfile   PatientProfile?
  doctorProfile    DoctorProfile?
  auditLogs        AuditLog[]

  @@map("users")
}

model Department {
  id          String         @id @default(uuid())
  name        String         @unique
  code        String         @unique // e.g., "CARDIO", "NEURO", "ORTHO"
  description String?
  icon        String?
  doctors     DoctorProfile[]
  createdAt   DateTime       @default(now())

  @@map("departments")
}

model DoctorProfile {
  id             String          @id @default(uuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department      @relation(fields: [departmentId], references: [id])
  specialization String
  qualification  String
  experienceYrs  Int             @default(1)
  consultationFee Float          @default(50.0)
  roomNumber     String
  biography      String?
  slotDurationMins Int           @default(15) // default 15 mins per patient
  isAvailable    Boolean         @default(true)
  
  // Relations
  schedules      DoctorSchedule[]
  appointments   Appointment[]
  consultations  ConsultationNote[]

  @@map("doctor_profiles")
}

model DoctorSchedule {
  id         String        @id @default(uuid())
  doctorId   String
  doctor     DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek  Int           // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime  String        // "09:00"
  endTime    String        // "17:00"
  breakStart String?       // "13:00"
  breakEnd   String?       // "14:00"
  isActive   Boolean       @default(true)

  @@unique([doctorId, dayOfWeek])
  @@map("doctor_schedules")
}

model PatientProfile {
  id               String        @id @default(uuid())
  userId           String        @unique
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth      DateTime?
  gender           String?       // "MALE", "FEMALE", "OTHER"
  bloodGroup       String?       // "O+", "A+", "B+", etc.
  emergencyContact String?
  medicalAlerts    String?       // Allergies, chronic conditions
  
  // Relations
  appointments     Appointment[]
  consultations    ConsultationNote[]

  @@map("patient_profiles")
}

model Appointment {
  id                String            @id @default(uuid())
  appointmentNumber String            @unique // e.g. "APT-20261018-8472"
  patientId         String
  patient           PatientProfile    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId          String
  doctor            DoctorProfile     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointmentDate   DateTime          // Date
  startTime         String            // "10:15"
  endTime           String            // "10:30"
  status            String            @default("SCHEDULED") // SCHEDULED, CHECKED_IN, IN_CONSULTATION, COMPLETED, CANCELLED
  reason            String?
  symptoms          String?
  consultationType  String            @default("IN_PERSON") // "IN_PERSON" | "TELECONSULT"
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Relationships
  queueToken        QueueToken?
  consultationNote  ConsultationNote?

  @@unique([doctorId, appointmentDate, startTime])
  @@map("appointments")
}

model QueueToken {
  id                   String       @id @default(uuid())
  tokenNumber          String       // e.g. "CARD-04"
  sequenceOrder        Int          // Sequential position in the daily clinic queue
  appointmentId        String       @unique
  appointment          Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  queueDate            DateTime     // Clinic day
  status               String       @default("WAITING") // WAITING, CALLED, IN_PROGRESS, FINISHED, SKIPPED
  estimatedWaitMinutes Int          @default(0)
  calledAt             DateTime?
  completedAt          DateTime?
  createdAt            DateTime     @default(now())

  @@map("queue_tokens")
}

model ConsultationNote {
  id             String         @id @default(uuid())
  appointmentId  String         @unique
  appointment    Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId      String
  patient        PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId       String
  doctor         DoctorProfile  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  chiefComplaint String
  diagnosis      String
  clinicalNotes  String?
  prescription   String?        // JSON string of medications
  labOrders      String?
  followUpDate   DateTime?
  createdAt      DateTime       @default(now())

  @@map("consultation_notes")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String
  ipAddress String?
  details   String?  // JSON details
  createdAt DateTime @default(now())

  @@map("audit_logs")
}
